# ---------------------------------------------------------------------------
# Expense Splitter — environment template
# Copy to `.env` at the repo root (consumed by docker-compose and Prisma),
# and see apps/api/.env.example / apps/web/.env.example for per-app values.
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_splitter

# Prisma / NestJS API connection string
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_splitter?schema=public"

# NestJS API
API_PORT=3001
# Comma-separated list of origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:3000

# Next.js web app — base URL of the API
NEXT_PUBLIC_API_URL=http://localhost:3001
